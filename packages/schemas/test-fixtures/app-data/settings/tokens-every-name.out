{
  "version": 1,
  "preferences": {
    "checkForUpdates": false,
    "launchMode": "game",
    "showGameUsernameInWindowTitle": false,
    "useGameTabs": false
  },
  "appearance": {
    "themeMode": "dark",
    "reduceMotion": "system",
    "useCursorPointers": false,
    "themes": {
      "light": {
        "tokens": {
          "background": "#ffffff",
          "foreground": "#262626",
          "card": "#ffffff",
          "cardForeground": "#262626",
          "popover": "#ffffff",
          "popoverForeground": "#262626",
          "primary": "#262626",
          "primaryForeground": "#fafafa",
          "secondary": "#f5f5f5",
          "secondaryForeground": "#262626",
          "muted": "#f5f5f5",
          "mutedForeground": "#5c5c5c",
          "accent": "#f5f5f5",
          "accentForeground": "#262626",
          "destructive": "#ef4444",
          "destructiveForeground": "#b91c1c",
          "success": "#10b981",
          "successForeground": "#047857",
          "warning": "#f59e0b",
          "warningForeground": "#b45309",
          "info": "#3b82f6",
          "infoForeground": "#1d4ed8",
          "border": "#ebebeb",
          "input": "#e5e5e5",
          "ring": "#a3a3a3"
        },
        "sansFont": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "monoFont": "ui-monospace, \"SFMono-Regular\", \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
        "sansFontSize": 14,
        "monoFontSize": 12,
        "rounding": 1
      },
      "dark": {
        "tokens": {
          "background": "#000000",
          "foreground": "#010203",
          "card": "#020406",
          "cardForeground": "#030609",
          "popover": "#04080c",
          "popoverForeground": "#050a0f",
          "primary": "#060c12",
          "primaryForeground": "#070e15",
          "secondary": "#081018",
          "secondaryForeground": "#09121b",
          "muted": "#0a141e",
          "mutedForeground": "#0b1621",
          "accent": "#0c1824",
          "accentForeground": "#0d1a27",
          "destructive": "#0e1c2a",
          "destructiveForeground": "#0f1e2d",
          "success": "#102030",
          "successForeground": "#112233",
          "warning": "#122436",
          "warningForeground": "#132639",
          "info": "#14283c",
          "infoForeground": "#152a3f",
          "border": "#162c42",
          "input": "#172e45",
          "ring": "#183048"
        },
        "sansFont": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "monoFont": "ui-monospace, \"SFMono-Regular\", \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
        "sansFontSize": 14,
        "monoFontSize": 12,
        "rounding": 1
      }
    }
  },
  "hotkeys": {
    "bindings": [
      {
        "id": "toggleTopBar",
        "value": "Mod+Shift+T"
      },
      {
        "id": "loadScript",
        "value": "Mod+O"
      },
      {
        "id": "toggleScript",
        "value": "Mod+Shift+X"
      },
      {
        "id": "toggleScriptsDialog",
        "value": "Mod+Shift+S"
      },
      {
        "id": "toggleOptionsMenu",
        "value": "Mod+Shift+,"
      },
      {
        "id": "openEnvironment",
        "value": "Alt+E"
      },
      {
        "id": "openLoaderGrabber",
        "value": ""
      },
      {
        "id": "openFollower",
        "value": "Alt+F"
      },
      {
        "id": "openPackets",
        "value": ""
      },
      {
        "id": "toggleAutoattack",
        "value": "Alt+A"
      },
      {
        "id": "toggleFollower",
        "value": "Alt+Shift+F"
      },
      {
        "id": "toggleBank",
        "value": "Mod+B"
      },
      {
        "id": "toggleInfiniteRange",
        "value": "Alt+I"
      },
      {
        "id": "toggleProvokeCell",
        "value": ""
      },
      {
        "id": "toggleEnemyMagnet",
        "value": ""
      },
      {
        "id": "toggleInterfaceOnlyRendering",
        "value": "Alt+L"
      },
      {
        "id": "toggleMinimalRendering",
        "value": "Alt+Shift+L"
      },
      {
        "id": "toggleHidePlayers",
        "value": ""
      },
      {
        "id": "toggleSkipCutscenes",
        "value": ""
      },
      {
        "id": "toggleAntiCounter",
        "value": ""
      },
      {
        "id": "toggleAnimations",
        "value": ""
      },
      {
        "id": "toggleCollisions",
        "value": ""
      },
      {
        "id": "toggleDeathAds",
        "value": ""
      }
    ]
  }
}
